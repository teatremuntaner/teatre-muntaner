---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/fx.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  useT, langFromPath, equivalentPath, stripLocale,
  HTML_LANG, OG_LOCALE, LANGS,
} from '../i18n';

// Capa de efectos visuales (tm-fx). true = activa para todo el mundo.
// (?fx=0 en la URL la apaga puntualmente; la preferencia se recuerda en el
// navegador. No es una opción anunciada, solo una salida de emergencia.)
const FX_ENABLED = true;

interface Props {
  title: string;
  description?: string;
  accent?: string;        // color predominante del cartel
  accentInk?: string;     // color de texto legible sobre el acento
  titleFont?: string;     // nombre CSS de la tipografía del título (como la del cartel)
  titleFontUrl?: string;  // <link> a la hoja de esa tipografía (solo si es de esta web)
  image?: string;         // og:image
  bare?: boolean;         // landing de campaña: sin header/footer y siempre noindex
  noindex?: boolean;      // página funcional sin valor para resultados de búsqueda
}
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);

const {
  title,
  description = t('meta.descripcion'),
  accent = '#bd221f',
  accentInk = '#ffffff',
  titleFont,
  titleFontUrl,
  image,
  bare = false,
  noindex = false,
} = Astro.props;

const SITE = Astro.site ?? new URL('https://teatremuntaner.com');
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = image ?? new URL('og.jpg', SITE).href;
// Web de pruebas: noindex. Al pasar a teatremuntaner.com se pone INDEXABLE=true.
const indexable = process.env.INDEXABLE === 'true';

// hreflang: cada pagina declara su equivalente en el otro idioma. Es lo que le
// dice a Google que /ca/x es la version catalana de /x (y no contenido duplicado).
const alternates = LANGS.map((l) => ({
  lang: HTML_LANG[l],
  href: new URL(equivalentPath(Astro.url.pathname, l), SITE).href,
}));
const xDefault = new URL(stripLocale(Astro.url.pathname), SITE).href;

// La tipografía especial de un título solo se carga si se sirve desde esta
// misma web (public/fonts). Una hoja de Google Fonts mandaría la IP del
// visitante a Google antes de que acepte nada (E267): se ignora y el título
// cae en la tipografía de la casa.
const titleFontHref = (() => {
  if (!titleFontUrl) return undefined;
  try {
    if (new URL(titleFontUrl, SITE).host === SITE.host) return titleFontUrl;
  } catch {}
  console.warn(`[BaseLayout] titleFontUrl de otro dominio ignorado: ${titleFontUrl}`);
  return undefined;
})();

const bodyStyle =
  `--accent:${accent};--accent-ink:${accentInk};` +
  (titleFont ? `--f-title:'${titleFont}', var(--f-display);` : '');
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <!-- Capa de efectos (tm-fx): activa la clase antes de pintar para no parpadear -->
    <script is:inline define:vars={{ fxDefault: FX_ENABLED }}>
      (function () {
        try {
          var p = new URLSearchParams(location.search), v = p.get('fx');
          if (v === '1' || v === '0') localStorage.setItem('tm-fx', v);
          var s = localStorage.getItem('tm-fx');
          var on = s === null ? !!fxDefault : s === '1';
          if (on) document.documentElement.classList.add('tm-fx-on');
        } catch (e) {}
      })();
    </script>
    <!-- Contenido de terceros (YouTube, reels, mapa): si el consentimiento guardado
         ya incluye marketing, se marca antes de pintar para que no asome el aviso
         de "acepta las cookies" un instante. Es solo visual: lo que carga los
         iframes es el script del banner, al final del body (E267). -->
    <script is:inline>
      (function () {
        try {
          var m = document.cookie.match(/(?:^|;\s*)cc_cookie=([^;]*)/);
          var c = m && JSON.parse(decodeURIComponent(m[1]));
          if (c && c.categories && c.categories.indexOf('marketing') !== -1) document.documentElement.classList.add('tm-mkt');
        } catch (e) {}
      })();
    </script>
    <!-- Consent Mode v2: por defecto DENEGADO hasta que el usuario acepte (RGPD/LSSI) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent','default',{
        ad_storage:'denied', ad_user_data:'denied', ad_personalization:'denied',
        analytics_storage:'denied', functionality_storage:'granted', security_storage:'granted',
        wait_for_update: 500
      });
      gtag('set', 'ads_data_redaction', true);
    </script>
    <!-- Sin Google Tag Manager (E271). Google Analytics y el píxel de Meta los carga
         el script del banner de cookies (al final del body), cada uno con su casilla:
         Analytics solo con la estadística y Meta solo con el marketing. Sin elegir o
         rechazando, no sale nada hacia Google ni Meta (E265). -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14100e" />
    <title>{title} · Teatre Muntaner</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!bare && alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    {!bare && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {(!indexable || bare || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${import.meta.env.BASE_URL}favicon-64.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon-180.png`} />
    <!-- Tipografías autoalojadas (src/styles/fonts.css): nada sale hacia Google Fonts -->
    <link rel="preload" href={`${import.meta.env.BASE_URL}fonts/reddit-sans-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL}fonts/oswald-latin.woff2`} as="font" type="font/woff2" crossorigin />
    {titleFontHref && <link href={titleFontHref} rel="stylesheet" />}
    <!-- Banner de cookies (vanilla-cookieconsent, gratis/open-source) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vanilla-cookieconsent@3.1.0/dist/cookieconsent.css" />
    <style is:inline>
      #cc-main {
        --cc-font-family: 'Reddit Sans', system-ui, sans-serif;
        --cc-btn-primary-bg: #bd221f; --cc-btn-primary-hover-bg: #9e1c19; --cc-btn-primary-border-color: #bd221f; --cc-btn-primary-hover-border-color: #9e1c19;
        --cc-btn-primary-color: #fff; --cc-btn-primary-hover-color: #fff;
        --cc-link-color: #bd221f; --cc-toggle-on-bg: #bd221f;
      }
    </style>
    <meta property="og:title" content={`${title} · Teatre Muntaner`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:site_name" content="Teatre Muntaner" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Teatre Muntaner`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body style={bodyStyle}>
    {!bare && <Header />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}

    <!-- Animación (gratis): GSAP + SplitText para los títulos. Sin smooth scroll. -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>

    <!-- Capa de efectos visuales (no hace nada salvo que tm-fx-on esté activa) -->
    <script>
      import '../scripts/fx';
    </script>

    <!-- Login del CMS para el personal (Netlify Identity; invisible si no está en Netlify) -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script define:vars={{ adminUrl: import.meta.env.BASE_URL + 'admin/' }}>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = adminUrl;
            });
          }
        });
      }
    </script>

    <!-- Consentimiento de cookies: banner + Consent Mode v2 + Analytics solo con estadística y Meta solo con marketing -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/vanilla-cookieconsent@3.1.0/dist/cookieconsent.umd.js"></script>
    <script is:inline define:vars={{ CC_LANG: lang, CC_T: {
      titulo: t('cookies.titulo'),
      descripcion: t('cookies.descripcion', { enlace: `<a href="${lang === 'ca' ? '/ca' : ''}/politica-de-cookies/">${t('cookies.enlaceTexto')}</a>` }),
      aceptar: t('cookies.aceptar'),
      rechazar: t('cookies.rechazar'),
      configurar: t('cookies.configurar'),
      prefTitulo: t('cookies.prefTitulo'),
      aceptarTodo: t('cookies.aceptarTodo'),
      rechazarTodo: t('cookies.rechazarTodo'),
      guardar: t('cookies.guardar'),
      cerrar: t('cookies.cerrar'),
      necesariasTitulo: t('cookies.necesariasTitulo'),
      necesariasDesc: t('cookies.necesariasDesc'),
      analiticasTitulo: t('cookies.analiticasTitulo'),
      analiticasDesc: t('cookies.analiticasDesc'),
      marketingTitulo: t('cookies.marketingTitulo'),
      marketingDesc: t('cookies.marketingDesc'),
      masInfoTitulo: t('cookies.masInfoTitulo'),
      masInfoDesc: t('cookies.masInfoDesc', { enlace: `<a href="${lang === 'ca' ? '/ca' : ''}/politica-de-cookies/">${t('cookies.enlaceTexto')}</a>` }),
    } }}>
      (function () {
        if (!window.CookieConsent) return;
        // Cookies que dejan Analytics y Meta, por categoría. Se borran al retirar
        // el consentimiento (autoClear) y la página se recarga para que lo ya
        // cargado deje de ejecutarse. «_gcl_*» ya no la pone nadie (no hay Google
        // Ads), pero se sigue borrando por si quedó de cuando había Tag Manager.
        var COOKIES = {
          analytics: [/^_ga($|_)/, /^_gid$/, /^_gat/],
          marketing: [/^_fbp$/, /^_fbc$/, /^_gcl_/]
        };
        // Sin Google Tag Manager (E271): las dos etiquetas que tenía el contenedor
        // de Nave8 van aquí, cada una atada a su casilla.
        // - Google Analytics 4 (G-3LC1FMXQFM): SOLO con la estadística aceptada y
        //   DESPUÉS de actualizar el consent mode, así la vista de página ya sale
        //   con el consentimiento real. Sin estadística no se carga (modo básico:
        //   ni siquiera pings sin cookies).
        // - Píxel de Meta (1316984187145278): SOLO con el marketing aceptado, sin
        //   depender de la estadística. Meta no obedece el consent mode de Google:
        //   lo que lo frena es no cargarlo.
        // Las dos mandan la vista de página al cargarse: si se aceptan a mitad de
        // visita, la página en curso cuenta sin tener que recargar.
        var gaCargado = false, metaCargado = false;
        function cargarAnalytics() {
          if (gaCargado) return;
          gaCargado = true;
          var j = document.createElement('script');
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtag/js?id=G-3LC1FMXQFM';
          document.head.appendChild(j);
          gtag('js', new Date());
          gtag('config', 'G-3LC1FMXQFM');
        }
        function cargarMeta() {
          if (metaCargado) return;
          metaCargado = true;
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '1316984187145278');
          fbq('track', 'PageView');
        }
        // Borra las cookies de las categorías NO aceptadas. Hace falta al arrancar:
        // una versión anterior cargaba GTM siempre y dejó _ga/_fbp a quien había
        // rechazado, y autoClear solo actúa al cambiar de opinión, no al volver
        // con un consentimiento ya guardado. Se prueba sin domain (host-only) y
        // con cada dominio padre (.teatremuntaner.com); no recarga.
        function limpiarDenegadas() {
          var partes = location.hostname.split('.'), dominios = [null];
          for (var i = 0; i < partes.length - 1; i++) dominios.push('.' + partes.slice(i).join('.'));
          var nombres = document.cookie.split(';').map(function (c) { return c.split('=')[0].trim(); });
          Object.keys(COOKIES).forEach(function (cat) {
            if (CookieConsent.acceptedCategory(cat)) return;
            nombres.forEach(function (n) {
              if (!COOKIES[cat].some(function (re) { return re.test(n); })) return;
              dominios.forEach(function (d) {
                document.cookie = n + '=; path=/' + (d ? '; domain=' + d : '') + '; expires=Thu, 01 Jan 1970 00:00:01 GMT';
              });
            });
          });
        }
        function syncConsent() {
          limpiarDenegadas();
          var analytics = CookieConsent.acceptedCategory('analytics');
          var marketing = CookieConsent.acceptedCategory('marketing');
          if (typeof gtag === 'function') {
            gtag('consent', 'update', {
              analytics_storage: analytics ? 'granted' : 'denied',
              ad_storage: marketing ? 'granted' : 'denied',
              ad_user_data: marketing ? 'granted' : 'denied',
              ad_personalization: marketing ? 'granted' : 'denied'
            });
          }
          if (analytics) cargarAnalytics();
          if (marketing) cargarMeta();
          aplicarTerceros();
        }
        // Contenido de terceros incrustado (vídeos de YouTube, mapa de Google,
        // reels de Instagram/TikTok): deja cookies y avisa a esas empresas de la
        // visita, así que va con el MARKETING (E267). Sin él, los iframes se
        // quedan sin src (data-consent-src) y se ve el aviso .consent-gate con el
        // botón "Configurar cookies". Al aceptarlo, se cargan sin recargar; al
        // retirarlo, autoClear recarga la página y vuelven a quedarse sin cargar.
        function aplicarTerceros() {
          var mkt = CookieConsent.acceptedCategory('marketing');
          document.documentElement.classList.toggle('tm-mkt', mkt);
          if (mkt) {
            // srcdoc: lo deja así plugins/remark-terceros.mjs con un iframe pegado en un texto.
            document.querySelectorAll('iframe[data-consent-src], iframe[data-consent-srcdoc]').forEach(function (f) {
              var doc = f.getAttribute('data-consent-srcdoc');
              if (doc !== null && !f.hasAttribute('srcdoc')) f.setAttribute('srcdoc', doc);
              var src = f.getAttribute('data-consent-src');
              if (src !== null && !f.getAttribute('src')) f.setAttribute('src', src);
            });
          }
          document.dispatchEvent(new CustomEvent('tm:consent', { detail: { marketing: mkt } }));
        }
        // Al aceptar una categoría más a mitad de visita, syncConsent carga lo que
        // falte. Al retirar una, recarga autoClear (reloadPage), que además borra
        // sus cookies: lo ya cargado deja de ejecutarse y no se vuelve a cargar.
        function autoClear(cat) {
          return { reloadPage: true, cookies: COOKIES[cat].map(function (re) { return { name: re }; }) };
        }
        var arranque = CookieConsent.run({
          guiOptions: {
            consentModal: { layout: 'box wide', position: 'bottom left' },
            preferencesModal: { layout: 'box' }
          },
          categories: {
            necessary: { enabled: true, readOnly: true },
            analytics: { autoClear: autoClear('analytics') },
            marketing: { autoClear: autoClear('marketing') }
          },
          onConsent: syncConsent,
          onChange: syncConsent,
          language: {
            default: CC_LANG,
            translations: {
              [CC_LANG]: {
                consentModal: {
                  title: CC_T.titulo,
                  description: CC_T.descripcion,
                  acceptAllBtn: CC_T.aceptar,
                  acceptNecessaryBtn: CC_T.rechazar,
                  showPreferencesBtn: CC_T.configurar
                },
                preferencesModal: {
                  title: CC_T.prefTitulo,
                  acceptAllBtn: CC_T.aceptarTodo,
                  acceptNecessaryBtn: CC_T.rechazarTodo,
                  savePreferencesBtn: CC_T.guardar,
                  closeIconLabel: CC_T.cerrar,
                  sections: [
                    { title: CC_T.necesariasTitulo, description: CC_T.necesariasDesc, linkedCategory: 'necessary' },
                    { title: CC_T.analiticasTitulo, description: CC_T.analiticasDesc, linkedCategory: 'analytics' },
                    { title: CC_T.marketingTitulo, description: CC_T.marketingDesc, linkedCategory: 'marketing' },
                    { title: CC_T.masInfoTitulo, description: CC_T.masInfoDesc }
                  ]
                }
              }
            }
          }
        });
        // Sin consentimiento válido (primera visita o revisión caducada) no salta
        // onConsent: se limpia igual, con todo lo no aceptado.
        function alArrancar() { limpiarDenegadas(); aplicarTerceros(); }
        Promise.resolve(arranque).then(alArrancar, alArrancar);
        // Enlace "Configurar cookies" (footer u otros) para reabrir el panel
        document.addEventListener('click', function (e) {
          var t = e.target.closest && e.target.closest('[data-cc="show-preferences"]');
          if (t) { e.preventDefault(); CookieConsent.showPreferences(); }
        });
      })();
    </script>
  </body>
</html>
