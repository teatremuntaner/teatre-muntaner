---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reels from '../../components/Reels.astro';
import Funciones from '../../components/Funciones.astro';
import { summarize, hoyEnMadrid } from '../../lib/schedule';
import { limpiaEspacios } from '../../lib/espacios.mjs';
import { useT, langFromPath } from '../../i18n';

export async function getStaticPaths() {
  const shows = await getCollection('espectaculos', ({ data }) => !data.draft && !data.externalUrl);
  return shows.map((show) => ({ params: { slug: show.id }, props: { show } }));
}

const { show } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);

// Texto en catalán: lo genera scripts/translate_ca.py. Si faltara (un show
// recién dado de alta con Apertium caído), se cae al castellano sin romper:
// mejor la ficha en castellano que una página vacía.
const ca = lang === 'ca' ? await getEntry('espectaculosCa', show.id) : undefined;
const fuente = ca ?? show;

const { Content } = await render(fuente as any);

// El título, el artista y el lugar SIEMPRE salen de la ficha castellana:
// son nombres propios y no se traducen. Del catalán solo llega el texto.
const d = {
  ...show.data,
  ...(ca
    ? Object.fromEntries(
        Object.entries({
          tagline: ca.data.tagline,
          promo: ca.data.promo,
          category: ca.data.category,
          genres: ca.data.genres?.length ? ca.data.genres : undefined,
          lang: ca.data.lang,
          duration: ca.data.duration,
          price: ca.data.price,
        }).filter(([, v]) => v !== undefined && v !== ''),
      )
    : {}),
};

// Puntuación con un decimal, con la coma decimal del idioma que toque
const fmtScore = (n: number) => n.toLocaleString(lang === 'ca' ? 'ca-ES' : 'es-ES', { maximumFractionDigits: 1 });
// Los miles, SIEMPRE con su punto. Hay que pedirlo: por defecto el castellano deja las
// cifras de cuatro dígitos sin separador, y en la misma fila quedaba «13.307 opiniones»
// al lado de «1386 opiniones». Medido en la ficha de Corta el cable rojo.
const fmtCount = (n: number) =>
  n.toLocaleString(lang === 'ca' ? 'ca-ES' : 'es-ES', { useGrouping: true });

/* Una pastilla solo se pinta si dice algo: la nota que tiene en esa web, o el sitio
   donde se puede opinar. Sin ninguna de las dos cosas no hay pastilla que valga.
   (Codex, 29/08/2026: sin esto salía un óvalo vacío.) */
const ratings = d.ratings.filter((r) => r.score !== undefined || r.votar);

const today = hoyEnMadrid();
const sch = d.dates.length ? summarize(d.dates, lang, today) : null;
// Cuantos dias se ven sin desplegar. Quien entra viene a decidir uno, no a leerlos todos.
const VISIBLES = 6;
const archived = d.dates.length > 0 && !d.dates.some((x) => x.date >= today);
const genre = d.genres.length ? d.genres.join(' · ') : d.category;
// Acepta ID o cualquier URL de YouTube (watch, youtu.be, embed, shorts)
const ytId = d.youtube
  ? (d.youtube.match(/(?:youtu\.be\/|v=|embed\/|shorts\/|^)([A-Za-z0-9_-]{11})/)?.[1] ?? '')
  : '';

// Descripción SEO: tagline si existe; si no, un extracto de la sinopsis
// (en el idioma de la página).
const plain = limpiaEspacios((fuente.body ?? '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#*_>`~]/g, '')
  .replace(/\s+/g, ' ')
  .trim());
const desc =
  d.tagline ??
  (plain ? (plain.length > 155 ? plain.slice(0, 152).replace(/\s+\S*$/, '') + '…' : plain) : t('show.descFallback', { titulo: d.title }));

// Datos estructurados: un TheaterEvent por función.
const SITE = Astro.site ?? new URL('https://teatremuntaner.com');
const posterUrl = new URL(d.poster.src, SITE).href;

// endDate = inicio + duración real (o 90 min si no consta). Sin hora, acaba el mismo día.
const showMinutes = Number(d.duration?.match(/(\d+)\s*min/i)?.[1] ?? 90);
const endOf = (dt: { date: string; time?: string }) => {
  if (!dt.time) return dt.date;
  const t = new Date(`${dt.date}T${dt.time}:00Z`);
  t.setUTCMinutes(t.getUTCMinutes() + showMinutes);
  return t.toISOString().slice(0, 16);
};

// Offer completo (price/priceCurrency/validFrom los rellena el sync de Qwantic;
// si faltan se omiten, no se inventan).
// Nota: NO ponemos price/priceCurrency. El priceFrom de Qwantic no es fiable
// (mezcla 2x1 y promos), y un precio engañoso en Google es peor que ninguno.
const offer = d.ticketUrl
  ? {
      '@type': 'Offer',
      url: d.ticketUrl,
      availability: 'https://schema.org/InStock',
      ...(d.saleStart ? { validFrom: d.saleStart } : {}),
    }
  : null;

const mkEvent = (dt: { date: string; time?: string }) => ({
  '@context': 'https://schema.org',
  '@type': 'TheaterEvent',
  name: d.title,
  performer: { '@type': 'PerformingGroup', name: d.artist ?? d.title },
  startDate: dt.date + (dt.time ? 'T' + dt.time : ''),
  endDate: endOf(dt),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: posterUrl,
  description: desc,
  location: {
    '@type': 'Place',
    name: 'Teatre Muntaner',
    address: { '@type': 'PostalAddress', streetAddress: 'Carrer de Muntaner 4', addressLocality: 'Barcelona', postalCode: '08011', addressCountry: 'ES' },
  },
  organizer: { '@type': 'Organization', name: 'Teatre Muntaner', url: 'https://teatremuntaner.com' },
  ...(offer ? { offers: offer } : {}),
});
// Limitamos los TheaterEvent del JSON-LD a las próximas ~50 funciones: shows con
// muchísimas fechas (Corta el cable rojo) inflarían el HTML sin aportar a SEO.
// Solo funciones POR VENIR, y el corte se aplica DESPUES de filtrar: si no, en un
// espectaculo largo las funciones ya dadas se comian el cupo y las de verdad se quedaban
// fuera de Google. Lo vio Codex el 28/08/2026.
const eventsLd = d.dates.filter((x) => x.date >= today).slice(0, 50).map(mkEvent);

// VideoObject del tráiler. Google EXIGE uploadDate (y thumbnailUrl): sin
// uploadDate el dato estructurado es inválido y Search Console lo marca como
// error crítico. Por eso solo emitimos el VideoObject si tenemos la fecha
// (YouTube: la saca el sync en youtubeUploadDate; vídeo subido: campo
// videoUploadDate). Si falta, no ponemos schema (el vídeo se sigue viendo).
const videoUploadDate = ytId ? d.youtubeUploadDate : d.videoUploadDate;
const videoLd = (ytId || d.video) && videoUploadDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: t('show.videoDe', { titulo: d.title }),
      description: desc,
      uploadDate: videoUploadDate,
      thumbnailUrl: ytId ? `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg` : posterUrl,
      ...(ytId
        ? {
            contentUrl: `https://www.youtube.com/watch?v=${ytId}`,
            embedUrl: `https://www.youtube-nocookie.com/embed/${ytId}`,
          }
        : { contentUrl: new URL(d.video, SITE).href }),
    }
  : null;
---

<BaseLayout
  title={d.title}
  description={desc}
  accent={d.accent}
  accentInk={d.accentInk}
  titleFont={d.titleFont}
  titleFontUrl={d.titleFontUrl}
>
  <article class="show">
    <!-- HERO tematizado con el color del cartel -->
    <section class="show__hero">
      <div class="show__hero-bg" aria-hidden="true"></div>
      <div class="wrap show__hero-inner">
        <div class="show__poster" data-tilt>
          <Image src={d.poster} alt={t('show.cartelDe', { titulo: d.title })} widths={[400, 700]} sizes="(max-width: 760px) 70vw, 360px" />
          <span class="show__poster-sheen" aria-hidden="true"></span>
        </div>
        <div class="show__head">
          <p class="eyebrow">{genre}</p>
          <h1 class="show__title" data-split>{d.title}</h1>
          {(d.artist ?? d.tagline) && <p class="show__tagline">{d.artist ?? d.tagline}</p>}

          {d.ticketAlarm ? (
            <p class="show__schedule">{t('show.proximamente')}</p>
          ) : archived ? (
            <p class="show__schedule show__schedule--ended">{t('show.finalizadas')}</p>
          ) : (
            <>
              {sch?.full && <p class="show__schedule">{sch.full}</p>}
              {!sch && d.dateText && <p class="show__schedule">{d.dateText}</p>}
              {sch && (
                <Funciones
                  dias={sch.dias}
                  aviso={sch.aviso}
                  ticketUrl={d.ticketUrl}
                  visibles={VISIBLES}
                  rotulo={t('show.proximasFunciones')}
                  verTodas={(n) => t('show.verFechas', { n })}
                  etiquetaCompra={(dia, fecha, hora) => t('show.comprarPara', { dia, fecha, hora })}
                />
              )}
            </>
          )}

          {d.promo && <p class="show__promo">🎟 {d.promo}</p>}

          {d.ticketAlarm ? (
            <form class="ticketalarm" name="ticketalarm" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/aviso-recibido/">
              <input type="hidden" name="form-name" value="ticketalarm" />
              <input type="hidden" name="show" value={d.title} />
              <p hidden><label>{t('show.noRellenar')} <input name="bot-field" /></label></p>
              <p class="ticketalarm__lead">{t('show.avisoLead')}</p>
              <div class="ticketalarm__row">
                <input type="email" name="email" required placeholder="tu@email.com" aria-label={t('show.tuEmail')} />
                <button class="btn btn--accent" type="submit">{t('show.avisame')}</button>
              </div>
            </form>
          ) : (
            <div class="show__cta">
              {!archived && d.ticketUrl && (
                <a class="btn btn--accent" href={d.ticketUrl} target="_blank" rel="noopener">{t('show.comprarEntradas')}</a>
              )}
              <a class="btn btn--ghost" href={`${import.meta.env.BASE_URL}#espectaculos`}>{t('show.volverCartelera')}</a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- CUERPO -->
    <section class="wrap show__body">
      <div class="show__prose">
        {d.photo && (
          <Image class="show__photo" src={d.photo} alt={t('show.fotoDe', { titulo: d.title })} widths={[400, 800]} sizes="(max-width: 760px) 100vw, 480px" />
        )}
        <Content />
      </div>
      <aside class="show__meta">
        <dl>
          {d.duration && (<><dt>{t('show.duracion')}</dt><dd>{d.duration}</dd></>)}
          {d.lang && (<><dt>{t('show.idioma')}</dt><dd>{d.lang}</dd></>)}
          {d.price && (<><dt>{t('show.precio')}</dt><dd>{d.price}</dd></>)}
          <dt>{t('show.lugar')}</dt><dd>{d.venue}</dd>
        </dl>
        {d.links.length > 0 && (
          <div class="show__links">
            <span class="show__links-title">{t('show.enlacesRedes')}</span>
            <div class="show__links-row">
              {d.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </section>

    {ratings.length > 0 && (
      <section class="wrap ratings">
        <ul class="ratings__row">
          {ratings.map((r) => {
            /* CADA PLATAFORMA, UNA PASTILLA, Y PUEDE LLEVAR DOS COSAS: la nota que tiene
               allí y, si esa web deja escribir reseña, un botón para hacerlo. Cuando van las
               dos, la pastilla se parte por la mitad con una raya: a la izquierda el dato, a
               la derecha la acción, en el color de marca.

               Y si no hay nota -- porque no la sabemos o porque el perfil es nuevo -- la
               pastilla entera es la invitación, con el nombre de la web dentro de la frase.
               Una pastilla igual que las de al lado pero con el hueco del número vacío se
               leería como un dato que falta, y no lo es. */
            const invita = r.score === undefined;
            const Ficha = r.url ? 'a' : 'div';
            return (
              <li class="rating">
                {!invita && (
                  <Ficha class="rating__ficha" {...(r.url ? { href: r.url, target: '_blank', rel: 'noopener' } : {})}>
                    {r.logo ? (
                      <Image class="rating__logo" src={r.logo} alt={r.source} widths={[120]} />
                    ) : (
                      <span class="rating__brand">{r.source}</span>
                    )}
                    <span class="rating__score">
                      <strong>{fmtScore(r.score)}</strong><span class="rating__max">/{fmtScore(r.max)}</span>
                    </span>
                    {r.count && <span class="rating__count">{`${fmtCount(r.count)} ${t('show.opiniones')}`}</span>}
                  </Ficha>
                )}
                {r.votar && (
                  <a
                    class="rating__votar"
                    href={r.votar}
                    target="_blank"
                    rel="noopener"
                    aria-label={t('show.opinaEn', { plataforma: r.source })}
                  >
                    <svg class="rating__estrella" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M12 3.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L12 16.9l-5.25 2.75 1-5.85L3.5 9.65l5.9-.85z"
                        fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
                      />
                    </svg>
                    <span class="rating__cta">
                      {invita ? t('show.opinaEn', { plataforma: r.source }) : t('show.opina')}
                    </span>
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {(d.video || ytId) && (
      <section class="wrap">
        <div class="show__video">
          {d.video ? (
            <video controls preload="metadata" src={d.video} aria-label={t('show.videoDe', { titulo: d.title })}></video>
          ) : (
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${ytId}`}
              title={t('show.videoDe', { titulo: d.title })}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          )}
        </div>
      </section>
    )}

    {d.cast.length > 0 && (
      <section class="wrap cast">
        <h2 class="cast__title">{t('show.artistas')}</h2>
        <ul class="cast__grid">
          {d.cast.map((p) => (
            <li class:list={['cast__item', p.offstage && 'cast__item--aparte']}>
              {p.photo && <Image class="cast__photo" src={p.photo} alt={p.name} widths={[160, 320]} sizes="120px" />}
              <span class="cast__name">{p.name}</span>
              {p.role && <span class="cast__role">{p.role}</span>}
            </li>
          ))}
        </ul>
        {d.castNote && <p class="cast__note">{d.castNote}</p>}
      </section>
    )}

    <Reels reels={d.reels} title={t('show.enRedes')} verEn={t('show.verEn')} />

    {d.gallery.length > 0 && (
      <section class="wrap show__gallery">
        <h2 class="show__gallery-title">{t('show.galeria')}</h2>
        <div class="show__gallery-grid">
          {d.gallery.map((img, i) => (
            <a class="glightbox show__gallery-item" href={img.src} data-gallery="show" aria-label={t('show.fotoNDe', { n: i + 1, titulo: d.title })}>
              <Image src={img} alt={t('show.fotoNDe', { n: i + 1, titulo: d.title })} widths={[300, 600]} sizes="(max-width: 700px) 45vw, 280px" />
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Barra de compra fija (solo móvil): "Comprar" siempre al alcance al leer la ficha -->
  {!d.ticketAlarm && !archived && d.ticketUrl && (
    <a class="show__buybar" href={d.ticketUrl} target="_blank" rel="noopener">{t('show.comprarEntradas')}</a>
  )}

  <!-- SEO: datos estructurados (un TheaterEvent por función) -->
  {eventsLd.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(eventsLd.length === 1 ? eventsLd[0] : eventsLd)} />
  )}
  {videoLd && <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />}
</BaseLayout>

<style>
  .show__hero { position: relative; overflow: hidden; padding: clamp(40px, 7vw, 90px) 0; }
  .show__hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(1200px 600px at 20% -10%, color-mix(in srgb, var(--accent) 75%, transparent), transparent 60%),
      linear-gradient(180deg, color-mix(in srgb, var(--accent) 32%, var(--ink)) 0%, var(--ink) 80%);
  }
  .show__hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 360px 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; perspective: 1100px; }
  .show__poster {
    position: relative; border-radius: 8px; overflow: hidden;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
    transform: rotateX(0) rotateY(0);
    transform-style: preserve-3d; will-change: transform;
    transition: transform 0.3s ease-out, box-shadow 0.35s ease;
  }
  .show__poster :global(img) { width: 100%; height: auto; display: block; }
  .show__poster-sheen {
    position: absolute; inset: 0; pointer-events: none; z-index: 2;
    background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.28) 50%, transparent 65%);
    background-size: 250% 250%; background-position: 130% 0;
    opacity: 0; transition: opacity 0.35s ease; mix-blend-mode: screen;
  }
  .show__poster.is-tilting { box-shadow: 0 45px 95px rgba(0,0,0,0.55), 0 0 75px -6px var(--accent); }
  .show__poster.is-tilting .show__poster-sheen { opacity: 1; }
  /* Móvil/táctil: sin tilt, flotación sutil */
  @media (hover: none) { .show__poster { animation: posterFloat 6s ease-in-out infinite; } }
  @keyframes posterFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
  @media (prefers-reduced-motion: reduce) { .show__poster { animation: none; } }
  .show__title { font-size: clamp(48px, 8vw, 104px); letter-spacing: 0.01em; text-transform: uppercase; overflow-wrap: normal; word-break: keep-all; text-wrap: balance; }
  .show__title :global(.word) { display: inline-block; }
  .show__tagline { font-family: var(--f-display); font-size: clamp(17px, 2vw, 22px); color: var(--paper-dim); margin-top: 14px; max-width: 40ch; }
  .show__dates { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .show__dates li { font-family: var(--f-display); font-size: 18px; }
  .show__date-day { text-transform: capitalize; }
  .show__date-time { color: var(--accent); font-weight: 600; }
  .show__schedule { font-family: var(--f-display); font-size: 19px; margin: 24px 0 0; color: var(--accent); letter-spacing: 0.02em; }
  .show__schedule--ended { color: var(--paper-faint); }
  .show__loose { font-family: var(--f-body); font-size: 15px; margin: 8px 0 0; color: var(--paper-dim); }

  .show__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .show__promo { display: inline-block; background: var(--c-gold, #d5a846); color: #14100e; font-weight: 800; font-family: var(--f-display); letter-spacing: 0.02em; padding: 9px 16px; border-radius: 999px; margin: 22px 0 0; font-size: 16px; }
  .ticketalarm { margin-top: 30px; max-width: 460px; }
  .ticketalarm__lead { font-family: var(--f-body); font-size: 15px; color: var(--paper-dim); margin: 0 0 12px; }
  .ticketalarm__row { display: flex; gap: 10px; flex-wrap: wrap; }
  .ticketalarm__row input[type="email"] { flex: 1 1 200px; min-width: 0; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--line); background: rgba(255,255,255,0.04); color: var(--paper); font: inherit; }
  .ticketalarm__row input[type="email"]:focus { outline: none; border-color: var(--accent); }

  .show__body { display: grid; grid-template-columns: 1fr 280px; gap: clamp(30px, 5vw, 60px); padding-top: clamp(40px, 6vw, 70px); }
  /* Cuerpo de sinopsis en casi negro: párrafos largos legibles sin fatiga. */
  /* 1.65 y no 1.8: con sinopsis de párrafos cortos (Barcelona Passió) el 1.8
     dejaba el texto demasiado aireado y costaba leerlo como un bloque. */
  .show__prose { font-size: 18px; line-height: 1.65; color: var(--paper); }
  .show__prose :global(p) { margin: 0 0 14px; }
  .show__prose :global(strong) { color: var(--paper); }
  .show__photo { float: right; width: 300px; max-width: 42%; height: auto; margin: 4px 0 18px 28px; border-radius: 6px; box-shadow: 0 18px 40px rgba(0,0,0,0.45); }
  /* Las notas de las webs de venta y de Google, en una fila de pastillas.
     El borde y el fondo son de la pastilla entera; el relleno, de cada mitad. Así las dos
     mitades -- la nota y el botón de opinar -- caben dentro del mismo óvalo con una raya
     entre medias, y cada una se ilumina sola al pasar por encima. */
  .ratings { padding-block: clamp(18px, 3vw, 30px) clamp(4px, 1vw, 10px); }
  .ratings__row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .rating {
    display: flex; align-items: stretch;
    border: 1px solid var(--line); border-radius: 999px; overflow: hidden;
    background: color-mix(in srgb, var(--accent) 5%, var(--ink));
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .rating:has(a):hover { border-color: var(--accent); transform: translateY(-2px); }
  .rating__ficha { display: flex; align-items: center; gap: 10px; padding: 10px 18px; }
  /* La mitad de opinar va con un fondo tenue de marca: es lo que la separa de un dato y
     la convierte en algo que se pulsa. Al pasar por encima se llena más. */
  .rating__votar {
    display: flex; align-items: center; gap: 7px; padding: 10px 16px;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent);
    transition: background 0.25s ease;
  }
  .rating__ficha + .rating__votar { border-left: 1px solid var(--line); }
  .rating__votar:hover { background: color-mix(in srgb, var(--accent) 20%, transparent); }
  .rating__brand { font-family: var(--f-display); font-size: 14px; letter-spacing: 0.04em; color: var(--paper-dim); }
  .rating__logo { height: 20px; width: auto; display: block; }
  .rating__score { font-family: var(--f-display); font-size: 20px; color: var(--accent); line-height: 1; }
  .rating__max { font-size: 13px; color: var(--paper-faint); }
  .rating__count { font-size: 12px; color: var(--paper-faint); }
